# Salin ke .env.local untuk pengembangan. Jangan pernah commit .env.local.
#
# Untuk Vercel, isi nilai yang sama di Project Settings → Environment Variables.

# Wajib. Connection string Neon (yang "Pooled connection").
# Kalau integrasi Neon dipasang dari marketplace Vercel, variabel ini terisi otomatis.
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Alamat publik aplikasi. Dipakai untuk tautan reset kata sandi dan undangan tim, dan sengaja
# dikunci di server supaya tautannya tidak bisa diarahkan lewat isi permintaan.
APP_URL=http://localhost:3000

# Email admin platform, dipisah koma. Kosong = panel Penjualan SaaS tidak bisa dibuka siapa pun.
PLATFORM_ADMIN_EMAILS=

# Hanya dibutuhkan untuk reset kata sandi. Undangan tim tidak memerlukannya.
RESEND_API_KEY=
MAIL_FROM=
