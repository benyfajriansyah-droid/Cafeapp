{
  // Konfigurasi deploy ke akun Cloudflare sendiri.
  //
  // Aplikasi ini tidak lagi bergantung pada proxy ChatGPT Sites: identitas pengguna datang dari
  // sesi milik aplikasi sendiri, jadi bisa dipasang di domain mana pun.
  //
  // Sebelum `npx wrangler deploy`:
  // Semua perintah di bawah menyebut berkas ini secara eksplisit dengan `-c`. Namanya sengaja
  // bukan `wrangler.jsonc`: `npm run dev` memakai konfigurasi Worker-nya sendiri lewat plugin
  // Vite, dan kalau ada `wrangler.jsonc` di akar proyek keduanya bergabung lalu bentrok.
  //
  //   1. Buat database   : npx wrangler d1 create famz-coffee-os
  //   2. Salin id-nya ke  : d1_databases[0].database_id di bawah
  //   3. Terapkan migrasi : npx wrangler d1 migrations apply famz-coffee-os --remote -c wrangler.deploy.jsonc
  //   4. Isi rahasia      : npx wrangler secret put RESEND_API_KEY -c wrangler.deploy.jsonc
  //
  //   5. Deploy          : npx wrangler deploy -c wrangler.deploy.jsonc
  //
  // CATATAN PENTING: masuk dan daftar memakai PBKDF2 210.000 iterasi (~32 ms CPU). Itu melewati
  // batas 10 ms paket Workers gratis, jadi akun harus di Workers Paid.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "famz-coffee-os",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "famz-coffee-os",
      // Ganti dengan id asli dari `wrangler d1 create`.
      "database_id": "GANTI_DENGAN_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  // Nilai non-rahasia. Yang rahasia (RESEND_API_KEY) dipasang lewat `wrangler secret put`,
  // bukan ditulis di sini — berkas ini ikut masuk ke repositori.
  "vars": {
    // Alamat publik aplikasi. Dipakai untuk tautan reset kata sandi dan undangan tim, dan
    // sengaja dikunci di server supaya tautannya tidak bisa diarahkan lewat isi permintaan.
    "APP_URL": "https://GANTI.DENGAN-DOMAIN-LO.com",
    // Email admin platform, dipisah koma. Kosong = panel Penjualan SaaS tidak bisa dibuka siapa pun.
    "PLATFORM_ADMIN_EMAILS": "",
    // Pengirim email reset kata sandi, mis. "Famz Coffee OS <halo@domain-lo.com>".
    "MAIL_FROM": ""
  },

  "observability": {
    "enabled": true
  }
}
